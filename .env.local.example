# === AI 제공자 선택 ===
# 대화(Chat)에 사용할 제공자: openai | upstage
# upstage로 두면 Solar(OpenAI 호환 API)를 사용. 음성(STT/TTS)은 항상 OpenAI 사용.
AI_PROVIDER=upstage

# === Upstage (Solar) === 대화용
# console.upstage.ai 에서 발급. 서버 전용, 절대 클라이언트 노출 금지.
UPSTAGE_API_KEY=up_...
UPSTAGE_CHAT_MODEL=solar-pro2
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# === OpenAI === (음성 STT/TTS에 사용. AI_PROVIDER=openai 이면 대화에도 사용)
# 서버 라우트에서만 사용. 절대 클라이언트에 노출 금지.
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# === Supabase ===
# URL과 anon key는 클라이언트 노출 가능(NEXT_PUBLIC_). service_role은 서버 전용.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === App ===
# 응답/비용 가드
MAX_OUTPUT_TOKENS=500
